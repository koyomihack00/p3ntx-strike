# Review-only. Non-secret settings for claude-worker.service; secrets are file paths.
CLAUDE_WORKER_LISTEN=unix:/run/claude-worker/worker.sock
CLAUDE_WORKER_TOKEN_FILE=/etc/claude-worker/bearer-token
CLAUDE_WORKER_CLI=/opt/claude-code/bin/claude
CLAUDE_WORKER_CLI_VERSION=pin-me
CLAUDE_WORKER_WORK_ROOT=/run/claude-worker/calls
CLAUDE_WORKER_OAUTH_TOKEN_FILE=/etc/claude-worker/oauth-token
CLAUDE_WORKER_HTTPS_PROXY=http://127.0.0.1:3128
CLAUDE_WORKER_MAX_CONCURRENT=2
CLAUDE_WORKER_MAX_TIMEOUT=10m
